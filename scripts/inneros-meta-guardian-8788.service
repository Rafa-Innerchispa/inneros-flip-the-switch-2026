[Unit]
Description=InnerOS Meta Guardian Web Console (Port 8788)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/rlopez/inneros/inneros-meta-guardian-2026
Environment=PYTHONPATH=/home/rlopez/inneros/inneros-meta-guardian-2026/src
Environment=PORT=8788
Environment=GUARDIAN_PUBLIC_MODE=true
Environment=GUARDIAN_UNSAFE_BIND=true
Environment=GUARDIAN_REQUIRE_AUTH=false
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m inneros_meta_guardian.web
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
